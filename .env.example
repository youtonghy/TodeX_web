# Copy to .env next to compose.yaml.

# Image tag to run (default: latest).
# TODEX_WEB_TAG=latest

# Host port the web client is published on.
PORT=4173

# Backends this deployment serves: comma-separated `Name=URL` (or just URL).
# Browsers reach them through this server at /backend/<id>/; every device
# still has to pass device verification on each backend. The backends must
# have transport encryption enabled.
TODEX_BACKENDS=Home=http://192.168.1.20:7345
